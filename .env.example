# ---------- TEST MODE (local Firebase emulators) ----------
USE_EMULATORS=false
VITE_USE_EMULATORS=false

# ---------- Frontend (Vite) — Firebase web app config ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- Server (Express) ----------
PORT=3001
# Paste the whole service-account JSON on one line (Railway: add as a variable)
FIREBASE_SERVICE_ACCOUNT=
# How often the EMGS tracker refresh runs (minutes). 0 = disabled
TRACKER_INTERVAL_MIN=60

# ---------- Logistics module ----------
# Named Firestore database used by Logistics (create it in Firebase console → Firestore → Add database)
VITE_LOGISTICS_DB_ID=logistics
LOGISTICS_DB_ID=logistics
# Copy Visa Paid / Registered students into the Logistics Arrivals Directory (set "off" to disable)
LOGISTICS_SYNC=on
# Web push (Firebase console → Project settings → Cloud Messaging → Web Push certificates → key pair)
VITE_FIREBASE_VAPID_KEY=
# Public address of the site — used in student feedback emails and links
VITE_PUBLIC_URL=https://your-express-tracker-domain.com
