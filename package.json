{
  "name": "express-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:kb": "tsx scripts/seed-kb.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json",
    "emulators": "cd functions && npm run build && cd .. && firebase emulators:start --import=./emulator-data --export-on-exit",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.0.2",
    "heic-to": "^1.6.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^1.3.0",
    "firebase-tools": "^14.0.0"
  }
}
