# SMTP / Email Configuration for Pioneer Logistics Cloud Functions
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
# For SendGrid / Mailgun / AWS SES: Use your SMTP provider credentials

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=it.pioneer4ss@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL="Pioneer Logistics Operations" <it.pioneer4ss@gmail.com>
REPLY_TO_EMAIL=edu@pioneer4ss.com

# Express Tracker
LOGISTICS_DB_ID=logistics
PUBLIC_URL=https://your-express-tracker-domain.com
